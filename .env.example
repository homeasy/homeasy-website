# Copy to .env.local and change only what you need. All defaults keep unproven claims hidden.

# Public address of this deployment. Leave unset on the real site (homeasy.io).
# On a test address set it, e.g. https://beta.homeasy.io: links in emails use it and search engines are blocked.
# NEXT_PUBLIC_SITE_URL=https://beta.homeasy.io

# Feature flags (PRD §16.3)
SHOW_PRICES=false
SHOW_INSTALLS=false
APP_LIVE=true
SHOW_ANNOUNCEMENT=false
SHOW_INVESTORS_PAGE=true
SHOW_BLOG=true
SHOW_CERTIFICATIONS=false
PRODUCT_PHOTOS_REAL=false
SHOW_DEMO=false

# USP flags (PRD §5.7, F27): turn on only when the pilot proves the promise (≥95% for 4 weeks)
# U2 = 30-min WhatsApp reply · U3 = "Same look" guarantee · U5 = 24-h technician visit
USP_U1=false
USP_U2=false
USP_U3=false
USP_U4=false
USP_U5=false
USP_U6=false
USP_U7=false
USP_U8=false
USP_U9=false
USP_U10=false
USP_U11=false
USP_U12=false

# Lead storage (server only, never commit real values). Create the table with supabase/schema.sql.
# Without these, `npm run dev` saves leads to .data/leads.json and production shows the WhatsApp fallback.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Lead alert emails through Resend (server only). Without RESEND_API_KEY no email is sent; leads are still saved.
# RESEND_API_KEY=
# LEAD_NOTIFY_TO=info@homeasy.io            # where alerts go; comma-separate several addresses
# LEAD_NOTIFY_FROM=Homeasy <leads@homeasy.io>   # needs homeasy.io verified in Resend; also enables customer confirmation emails

# Admin dashboard at /admin (server only). Both are needed; without them the admin is switched off.
# ADMIN_EMAIL=info@homeasy.io
# ADMIN_PASSWORD=choose-a-long-password
# ADMIN_SESSION_SECRET=any-long-random-text   # optional; signs the login cookie

# Online payments through Razorpay (server only). Without the first two, orders are saved and payment is arranged by phone.
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=   # the secret you type when adding the webhook https://homeasy.io/api/razorpay/webhook

# Optional: Google PageSpeed Insights key for Admin → SEO → Page speed (free from Google Cloud). Without it the shared quota is used.
PAGESPEED_API_KEY=

# Online buying (cart and checkout). Default true. Set false to show survey → quote → install only.
SHOW_CART=true
# "Delivery across Bihar" wording. Default true.
DELIVERY_ENABLED=true
# Words used for the service area (default: Bihar, from data/site.json).
NEXT_PUBLIC_SERVICE_AREA_LABEL=
# Google Analytics 4 measurement ID. Optional: the default is in data/site.json. Use "off" to disable analytics and the cookie banner.
# Analytics loads only after the visitor accepts cookies.
NEXT_PUBLIC_GA_ID=

# Where the build downloads the three Chillax files from (the repo is public, so they are not in it).
# A folder you control that contains Chillax-Regular.woff2, Chillax-Semibold.woff2 and Chillax-Bold.woff2,
# e.g. https://YOUR-PROJECT.supabase.co/storage/v1/object/public/site-fonts
FONT_SOURCE_URL=

# Public launch switch. false (default) = early-access mode: modules and app read "Launching Jan 2027",
# cart off, early-access bar on. Set true on launch day.
LAUNCHED=false

# AI assistant ("Ask Homeasy") in the bottom-right corner. Paid service: Anthropic bills per message.
# Without the key the website shows the WhatsApp button instead. CHAT_ENABLED=false switches it off while keeping the key.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5
CHAT_ENABLED=true
# Brake on spending: most AI replies per day across all visitors (per server instance).
CHAT_DAILY_CAP=2000

# WhatsApp bridge for website chats (Meta WhatsApp Business Cloud API). Optional.
# Visitor messages that ask for a person go to the team's WhatsApp; replies there appear in the visitor's chat.
# Webhook address to enter in Meta: https://YOUR-SITE/api/whatsapp/webhook (subscribe to "messages").
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Who receives chats and may reply: digits with country code, comma-separated, e.g. 919117379099
WHATSAPP_TEAM_NUMBERS=
# App secret (Meta app → Settings → Basic) and any phrase you choose for the webhook check
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optional: approved template with two text variables ({{1}} name, {{2}} message), used when the 24-hour window is closed
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=
